# .gitignore generated by Antigravity
# Ignore OS files
.DS_Store
Thumbs.db

# Ignore build output directories
bin/
obj/
build/

# Ignore Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore Node.js artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore IDE/editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore logs and temporary files
*.log
*.tmp
*.bak

# Custom project-specific entries (add your own patterns below)
# ------------------------------------------------------------
# Ignore environment files
.env
*.env
# Ignore virtual environments and trace folders
venv/
traces/
